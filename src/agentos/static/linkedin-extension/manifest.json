{
  "manifest_version": 3,
  "name": "AgentOS \u00b7 Browser Companion",
  "version": "0.4.2",
  "description": "Connect one LinkedIn tab to your hosted AgentOS workspace, or use the local companion.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "alarms",
    "sidePanel"
  ],
  "host_permissions": [
    "http://127.0.0.1:8765/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Open AgentOS companion"
  },
  "minimum_chrome_version": "116",
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://agentos-workspace-raj.netlify.app/*"
      ],
      "js": [
        "hosted-content.js"
      ],
      "all_frames": false,
      "run_at": "document_idle"
    }
  ]
}
